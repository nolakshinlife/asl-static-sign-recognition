# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# Logs
logs/*
!logs/.gitkeep

# Collected data and trained models stay local by default.
# Remove these lines if you decide to publish your dataset or model.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep
# Secrets and local configuration
.env
.env.*
!.env.example

# Backup files
*.bak